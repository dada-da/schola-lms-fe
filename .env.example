# ─── ScholaLMS — Environment Variables ────────────────────────────────────────
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and never committed.
#
# Naming rules:
#   NEXT_PUBLIC_*   →  exposed to the browser (safe for non-secret config)
#   Everything else →  server-only (never sent to the client)

# ─── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ScholaLMS
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ─── Backend ────────────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8080

# ─── Optional: OAuth providers ────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ─── Optional: Storage ────────────────────────────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ─── Optional: Payments ───────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# ─── Optional: Email ──────────────────────────────────────────────────────────
# RESEND_API_KEY=
# EMAIL_FROM=noreply@schola.com
