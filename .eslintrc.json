{
  "extends": [
    "next/core-web-vitals"
  ],
  "rules": {
    "react/self-closing-comp": "warn",
    "react/jsx-curly-brace-presence": ["warn", {
      "props": "never",
      "children": "never"
    }],
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "prefer-const": "error",
    "no-var": "error",
    "eqeqeq": ["error", "always"],
    "curly": ["warn", "multi-line"]
  },
  "ignorePatterns": [
    "node_modules/",
    ".next/",
    "out/",
    "dist/",
    "*.config.js",
    "*.config.ts"
  ]
}
